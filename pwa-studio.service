[Unit]
Description=PWA Studio - chat to generate and host mini apps
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/pwa-studio
EnvironmentFile=/opt/pwa-studio/.env
ExecStart=/usr/bin/node /opt/pwa-studio/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
