# Chat2App · app.freexlib.com
# 80 → 301 跳 https；443 反代到本机 8790

server {
    listen 80;
    listen [::]:80;
    server_name app.freexlib.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name app.freexlib.com;

    ssl_certificate     /etc/letsencrypt/live/app.freexlib.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/app.freexlib.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8790;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # SSE 流式输出必须关缓冲
        proxy_buffering off;
        proxy_cache off;
        # 生成可能较久，放宽超时（默认 60s 会掐断长生成，导致前端 Load failed）
        proxy_connect_timeout 30s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
