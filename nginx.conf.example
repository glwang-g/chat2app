# /etc/nginx/conf.d/pwa-studio.conf
# 假设你用 certbot 给 freexlib.com 配好了 HTTPS
server {
    listen 80;
    server_name freexlib.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name freexlib.com;

    ssl_certificate     /etc/letsencrypt/live/freexlib.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/freexlib.com/privkey.pem;

    client_max_body_size 10m;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # 关键：关掉缓冲，SSE 流式输出才能实时到浏览器
        proxy_buffering off;
        proxy_cache off;
    }
}
