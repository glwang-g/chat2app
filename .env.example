# 复制为 .env 并填写

# DeepSeek API Key（必填，https://platform.deepseek.com 创建）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 访问口令（推荐开启）：生成应用时需要带这个口令，保护你的 DeepSeek 额度
# 留空 = 不鉴权，任何人都能生成
API_TOKEN=

# 每小时每个 IP 最多生成次数（0 = 不限）
RATE_LIMIT_PER_HOUR=30

# 对外公开的域名（生成的网址前缀）
BASE_URL=https://freexlib.com

# 可选：改用其它 OpenAI 兼容端点
# DEEPSEEK_URL=https://api.deepseek.com/chat/completions
